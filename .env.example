# mcmod-mcp configuration
# Copy to .env and edit. All settings can also be provided as environment variables.

# ------------------------------------------------------------------ upstream
MCMOD_BASE_URL=https://www.mcmod.cn
MCMOD_SEARCH_URL=https://search.mcmod.cn
# MCMOD_USER_AGENT=mcmod-mcp/0.1 (SSR reader; +https://www.mcmod.cn/robots.txt)
MCMOD_TIMEOUT=20
# Minimum seconds between upstream requests. Be polite; do not set to 0 in production.
MCMOD_MIN_INTERVAL=1.0
MCMOD_MAX_RETRIES=2

# ------------------------------------------------------------------ database
# SQLite (default):
MCMOD_DATABASE_URL=sqlite:///./mcmod.db
# Absolute SQLite path:
# MCMOD_DATABASE_URL=sqlite:////var/lib/mcmod/mcmod.db
# MariaDB (normalised to mysql+pymysql://):
# MCMOD_DATABASE_URL=mariadb://mcmod:secret@127.0.0.1:3306/mcmod?charset=utf8mb4
# MySQL:
# MCMOD_DATABASE_URL=mysql+pymysql://mcmod:secret@127.0.0.1:3306/mcmod?charset=utf8mb4
MCMOD_DATABASE_ECHO=false
MCMOD_SQLITE_TIMEOUT=30

# --------------------------------------------------------------------- cache
MCMOD_CACHE_ENABLED=true
MCMOD_CACHE_TTL_SEARCH=900
MCMOD_CACHE_TTL_LIST=1800
MCMOD_CACHE_TTL_DETAIL=21600
MCMOD_CACHE_TTL_META=86400

# ----------------------------------------------------------------- API server
MCMOD_API_HOST=127.0.0.1
MCMOD_API_PORT=8000
# Base URL used by the CLI and MCP server.
MCMOD_API_BASE=http://127.0.0.1:8000
# Shared secret for the REST API and MCP HTTP endpoint. When set, clients must
# send Authorization: Bearer <value> or X-API-Key: <value>. Empty disables auth.
MCMOD_API_KEY=
# Comma-separated allowed browser origins, e.g. http://localhost:5173
MCMOD_CORS_ORIGINS=
